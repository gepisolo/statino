rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The admin email is also hardcoded client-side in src/lib/config.ts —
    // keep the two in sync.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'gepisolo@gmail.com';
    }

    // Access requires an invite: a doc in allowedUsers keyed by the
    // (lowercase) email. The admin is always allowed, so the list can be
    // bootstrapped from the app itself.
    function isAllowed() {
      return isAdmin()
        || (signedIn()
            && request.auth.token.email_verified
            && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)));
    }

    match /allowedUsers/{email} {
      // Anyone signed in may check their own invite (the app uses this to
      // show the "not authorized" screen); only the admin manages the list.
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if isAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }

    // Collaboratori: lavorano sui clienti dell'admin, ma NON hanno accesso
    // a users/{uid}/… (non stanno in allowedUsers). Tutto ciò che possono
    // toccare è qui: la propria scheda in lettura — che porta una copia
    // ripulita di clienti e contratti assegnati, senza tariffe — e le
    // proprie ore e attività. `active: false` sospende l'accesso senza
    // cancellare nulla.
    function isCollaboratorEmail(email) {
      return signedIn()
        && request.auth.token.email_verified
        && request.auth.token.email == email;
    }

    function isActiveCollaborator(email) {
      return isCollaboratorEmail(email)
        && get(/databases/$(database)/documents/collaborators/$(email)).data.active == true;
    }

    match /collaborators/{email} {
      allow get: if isAdmin()
        || (isCollaboratorEmail(email) && resource != null && resource.data.active == true);
      allow list, write: if isAdmin();

      // Lo statino lo scrive solo chi ha fatto le ore: l'admin lo legge (e
      // lo esporta), e può cancellarlo solo eliminando il collaboratore.
      match /entries/{entryId} {
        allow read, delete: if isAdmin() || isActiveCollaborator(email);
        allow create, update: if isActiveCollaborator(email);
      }

      // Le attività le gestiscono entrambi: l'admin le assegna e le segue.
      match /tasks/{taskId} {
        allow read, write: if isAdmin() || isActiveCollaborator(email);
      }
    }

    // Token Fatture in Cloud (non scade mai). Scritto dall'app quando lo si
    // configura, letto SOLO dalla Cloud Function con l'Admin SDK, che le
    // regole non le applica. Non può stare sotto users/{uid}/…: lì il
    // wildcard ricorsivo qui sopra concede già la lettura al client e le
    // regole sono in OR — una regola annidata non può revocare un permesso
    // già concesso da un'altra.
    match /integrationSecrets/{uid} {
      allow write: if isAllowed() && request.auth.uid == uid;
      allow read: if false;
    }
  }
}
