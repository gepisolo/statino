    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
